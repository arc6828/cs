<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    # Pass through existing files or directories directly
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Clean URL for content articles: /content/{slug} -> /content/{slug}.php (if file exists)
    RewriteCond %{REQUEST_FILENAME}.php -f
    RewriteRule ^content/([^/]+)/?$ content/$1.php [L]

    # Front controller for content listing and legacy articles (e.g. /content, /content/21)
    RewriteRule ^content(?:/(.*))?$ content/index.php [L] 
</IfModule>

# Ensure proper MIME type and charset for XML Sitemaps
<IfModule mod_mime.c>
    AddType application/xml;charset=UTF-8 .xml
</IfModule>
